# 로컬 개발용. 이 파일을 .env 로 복사하고 키를 채우세요. .env 는 깃에 올라가지 않습니다.
# 배포(Vercel)에서는 이 파일을 쓰지 않고 Project → Settings → Environment Variables 에 같은 이름으로 넣습니다.
# 어느 쪽이든 키는 서버(개발 서버 미들웨어 / 서버리스 함수)에서만 읽히고 브라우저 번들에는 들어가지 않습니다.

OPENAI_API_KEY=여기에_키를_붙여넣기

# 선택. 기본값은 gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# 선택. 프록시나 Azure 엔드포인트를 쓸 때만
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
